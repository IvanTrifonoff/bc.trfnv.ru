# Вариант A: прямой HTTPS (Caddy сам получает сертификат Let's Encrypt).
# SITE_ADDR=bc.trfnv.ru

# Вариант B: за nginx/ reverse proxy (как на нашем VPS) — Caddy отдаёт только HTTP,
# TLS терминирует nginx. Контейнер слушает только на localhost.
SITE_ADDR=:80
HTTP_BIND=127.0.0.1
HTTP_PORT=6031
HTTPS_BIND=127.0.0.1
HTTPS_PORT=6044
